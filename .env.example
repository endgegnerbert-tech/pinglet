# Server
PORT=3456
PINGLET_DATA_DIR=./data

# Protect admin reads: GET /packages and GET /stats
PINGLET_ADMIN_USER=admin
PINGLET_ADMIN_PASSWORD=change-this-long-random-password

# Optional write protection for POST /ping.
# Only use this for private/internal tools; in public npm packages this token is visible.
# PINGLET_INGEST_TOKEN=optional-write-token

# CLI client (optional; login stores this automatically)
PINGLET_SERVER_URL=http://localhost:3456
PINGLET_ADMIN_USER=admin
